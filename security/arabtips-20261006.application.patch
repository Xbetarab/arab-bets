+  await assert.rejects(commentEnv.load("comments").createComment(POST, "comment", null));
+  assert.equal(writes(commentEnv).length, 0);
+  const missingEnv = environment({ "admin:app_settings": [ok(null)], "admin:posts": [ok({ id: POST })] });
